//write a programe that trasforms an int value to binary using recursion
import java.util.Scanner;
public class int_to_bi_Rec{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        binary(n);
    }
    
    public static void binary(int n){
        if(n==0){
            return;
        }
        else{
            binary(n/2);
            return n%2;
        }
    }
}