public class arrayProb1{
    public static void main(String[] args){
        int[] arr = {5, 10, 15, 20};
        for(int i = 0;i<arr.length;i++){
            if(i == arr.length-1){
                arr[i] = arr[0];
            } 
            else{
                arr[i] = arr[i+1];
            }
        }
        for (int i = 0; i <arr.length; i++) {
            System.out.print(arr[i] + " ");
        }
    }
`}