import java.util.Scanner;
public class assignment5task7 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        if (n % 2 == 0) {
            System.out.println("invalid input");
        } else {
            int mid = n / 2;
            for (int k = 0; k <= mid; k++) {
                if (k == 0) {
                    for (int i = 1; i <= n; i++) System.out.print(i);
                    System.out.println();
                } else {
                    for (int i = 1; i <= k; i++) System.out.print(" ");
                    int j = n - 2 * k;
                    for (int i = 1; i <= j; i++) System.out.print(i);
                    for (int i = 1; i <= 2 * k - 1; i++) System.out.print(" ");
                    for (int i = j; i >= 1; i--) System.out.print(i);
                    System.out.println();
                }
            }
            for (int k = mid - 1; k >= 0; k--) {
                if (k == 0) {
                    for (int i = 1; i <= n; i++) System.out.print(i);
                    System.out.println();
                } else {
                    for (int i = 1; i <= k; i++) System.out.print(" ");
                    int j = n - 2 * k;
                    for (int i = 1; i <= j; i++) System.out.print(i);
                    for (int i = 1; i <= 2 * k - 1; i++) System.out.print(" ");
                    for (int i = j; i >= 1; i--) System.out.print(i);
                    System.out.println();
                }
            }
        }
    }
}
