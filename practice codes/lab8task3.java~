import java.util.Scanner;
public class lab8task3{
    public static boolean isPrime(int n){
        if(n==0 || n==1 || n<0){
            return false;
        }
        else{
            int div = 0;
            for(int i = 2;i<n;i++){
                if(n%i==0){
                    div++;
                }
            }
            if(div==0){
                return true;
            }
            else{
                return false;
            }
        }
    }
    public static void main(String[] args){
        boolean check = isPrime(7);
        System.out.println(check); 
    }
}