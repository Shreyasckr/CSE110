public class strProb1{
    public static void main(String[] args){
        String s = "aaaabbbccd";
        String res = "";
        char c;
        int count = 0;
        for(int i = 1;i<s.length();i++){
            c = s.charAt(i);
            if(c == s.charAt(i+1)){
                count++;
            }
            else{
                res += s.charAt(i) + count; 
                count = 0;
            }
        }
        System.out.println(res);
    }
}