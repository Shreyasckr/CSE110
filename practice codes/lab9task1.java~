import java.util.Scanner;
public class lab9task1{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        oneToN(1, n);
        nToOne(1, n);
        System.out.println(recursiveSum(1,n));
    }
    public static void oneToN(int a, int b){  //a
        if(a == b){
            System.out.println(b);
        }
        else{
            System.out.print(a+ " ");
            oneToN(a+1, b);
        }
    }
    
    public static void nToOne(int a, int b){  //b
        if(a == b){
            System.out.println(a);
        }
        else{
            System.out.print(b+ " ");
            oneToN(a, b-1);
        }
    }
    
    public static int recursiveSum(int a, int b){  //c
        if(b==1){
            return 1;
        }
        else{
            return b + recursiveSum(a,b-1);
        }
    }
}