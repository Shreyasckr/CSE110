import java.util.Scanner;
public class prac2{
    public static void main(String [] args){
        Scanner sc = new Scanner;
        int n = sc.nextInt();
        int temp = n;
        int digit = 0;
        for(temp = n;temp>0;temp/10){
            digit++;
        }
        for(int div = 1;digit>0;div*10){
            digit--;
        }
        int temp = n;
        for(temp=n;temp>0;div--){
            int digits = temp%div;
            temp /= div;
            System.out.println(digits);
        }
    }
}