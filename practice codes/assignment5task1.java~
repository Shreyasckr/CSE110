import java.util.Scanner;
public class assignment5task1{
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        for(int i=1;i<=n;i++){
            for(int j=1;j<=i-1;j++){
                System.out.print(" ");
            }
            for(int k=1;k<=2*i-1;k++){
                System.out.print(k);
            }
            System.out.println();
        }
        for(;i>0;i--){
            for(;j<=i-1;j--){
                System.out.print(" ");
            }
            for(;k>0;k--){
                System.out.print(k);
            }
            System.out.println();
        }
    }
}