import java.util.Scanner;
public class LtoRdigit{
    public static void main(String [] args){
        Scanner sc = new Scanner(System.in);
        int N = sc.nextInt();
        int count = 0;
        while(N>0){
            count++;
            N /= 10;
        }
        int temp = count;
        for(int i= 1; i<= temp ;i++){
            int digit = N/ (10*(count-1));
            System.out.print(digit + " ");
            count--;
        }
    }
}